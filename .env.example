# =============================================================================
# Platform Status Page — Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize for your deployment environment:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Networking & Service Ports
# -----------------------------------------------------------------------------
API_PORT=8085
WEB_PORT=3001
API_BASE_URL=http://localhost:8085

# -----------------------------------------------------------------------------
# Administrative Credentials (Username / Password Login)
# -----------------------------------------------------------------------------
PASSWORD_AUTH_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=admin # Recommended: change to a strong secret in production!
# LOCAL_USERS="alice:secret123,bob:securepass456"

# -----------------------------------------------------------------------------
# Enterprise SSO (OpenID Connect: Microsoft Entra ID / Okta)
# -----------------------------------------------------------------------------
# SSO_PROVIDER: mock (default for local dev) or oidc (for enterprise AD / Okta)
SSO_PROVIDER=mock
SSO_PROVIDER_NAME="Local Dev SSO"
# OIDC_ISSUER_URL=https://login.microsoftonline.com/{tenant-id}/v2.0
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# Optional: set full public URL when running behind corporate domain/ALB
# OIDC_REDIRECT_URL=https://status.yourdomain.com/auth/callback
# SSO_SUCCESS_REDIRECT_URL=https://status.yourdomain.com/admin
SESSION_SECRET=dev-secret-key-please-change-in-production-12345678

# -----------------------------------------------------------------------------
# Storage Engine (Hexagonal Architecture Adapter)
# Supported options: sqlite | dynamodb | s3
# -----------------------------------------------------------------------------
STORAGE_ENGINE=sqlite

# SQLite options (used when STORAGE_ENGINE=sqlite)
# For Docker Compose, /data/status.db is stored on a persistent volume
SQLITE_DSN=/data/status.db

# AWS DynamoDB options (used when STORAGE_ENGINE=dynamodb)
DYNAMODB_TABLE=status_records
# DYNAMODB_ENDPOINT=http://localhost:8000 # Optional: for LocalStack or DynamoDB Local

# AWS S3 options (used when STORAGE_ENGINE=s3)
S3_BUCKET=status-page-bucket
# S3_ENDPOINT=http://localhost:4566       # Optional: for LocalStack or MinIO

# AWS credentials & region (for DynamoDB or S3)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Incident Announcement Banners (Operator Controlled)
# -----------------------------------------------------------------------------
# Set active incident banners across all tenants ('*') or a specific tenant.
# Severities: critical | major | minor | maintenance | info
# States:     investigating | identified | monitoring | resolved
INCIDENT_BANNER_JSON='[
  {
    "id": "inc-001",
    "tenant": "*",
    "products": ["billing-engine"],
    "check_ids": ["tax-jurisdiction-check"],
    "features": ["tax-calc"],
    "title": "Elevated Latency in Tax Calculation Service",
    "severity": "minor",
    "state": "monitoring",
    "message": "We have rerouted traffic to backup providers and are monitoring transaction queues.",
    "active": true,
    "updates": [
      {
        "timestamp": "2026-09-27T10:00:00Z",
        "state": "investigating",
        "message": "Engineers received automated alerts for high response latency."
      },
      {
        "timestamp": "2026-09-27T10:20:00Z",
        "state": "identified",
        "message": "Identified latency spike originating from third-party tax calculation provider."
      },
      {
        "timestamp": "2026-09-27T10:45:00Z",
        "state": "monitoring",
        "message": "Traffic shifted to secondary provider. Queue processing is nominal."
      }
    ]
  }
]'

# -----------------------------------------------------------------------------
# Evaluation Worker Daemon Configuration
# -----------------------------------------------------------------------------
WORKER_LOOP_INTERVAL=5s

# Multi-pod / Multi-task worker coordination (EKS StatefulSet / ECS Service / K8s Deployment)
# - For EKS StatefulSets: set WORKER_SHARD_TOTAL=N; WORKER_SHARD_INDEX is auto-detected from pod hostname (-0, -1, etc.)
# - For ECS or standard K8s Deployments: WORKER_LEASE_ENABLED=true uses atomic storage leases (DynamoDB / SQLite)
#   to prevent duplicate work across tasks automatically.
WORKER_SHARD_TOTAL=1
# WORKER_SHARD_INDEX=0
WORKER_LEASE_ENABLED=true
WORKER_LEASE_DURATION=30s
# WORKER_ID=

# Playwright Headless Browser Runner Microservice
PLAYWRIGHT_RUNNER_URL=http://playwright-runner:8088/run
PLAYWRIGHT_RUNNER_PORT=8088

# STATUS_DEF_JSON defines all products, pull intervals, and modular health checks.
# Two forms are supported:
#   1. Document form (below): reusable "templates" stamped out per tenant via "items".
#      Items can set "variables" (substituted as {{var}} in check fields; {{tenant}}
#      and {{product}} are built in) and "check_overrides" (merge/remove checks by id).
#   2. Legacy form: a bare JSON array of {tenant, product, pull_interval_seconds, checks}.
STATUS_DEF_JSON='{
  "templates": {
    "cloud-api": {
      "product": "cloud-api",
      "pull_interval_seconds": 10,
      "checks": [
        {
          "id": "gateway-routing-check",
          "feature": "api-gateway",
          "type": "synthetic",
          "target": "https://gateway.cloud.internal/health",
          "timeout_ms": 3000,
          "parameters": {
            "simulated_state": "operational",
            "message": "Gateway edge routing nominal"
          }
        },
        {
          "id": "redis-rate-limiter-check",
          "feature": "rate-limiter",
          "type": "synthetic",
          "target": "ratelimiter.cloud.internal:6379",
          "timeout_ms": 1500,
          "parameters": {
            "simulated_state": "operational",
            "message": "Quota token bucket operational"
          }
        }
      ]
    },
    "auth-service": {
      "product": "auth-service",
      "pull_interval_seconds": 15,
      "checks": [
        {
          "id": "oidc-jwks-check",
          "feature": "oauth2",
          "type": "synthetic",
          "target": "https://auth.cloud.internal/.well-known/openid-configuration",
          "timeout_ms": 3000,
          "parameters": {
            "simulated_state": "operational",
            "message": "JWKS public keys rotating normally"
          }
        },
        {
          "id": "session-cache-check",
          "feature": "sessions",
          "type": "synthetic",
          "target": "sessions.cloud.internal:11211",
          "timeout_ms": 2000,
          "parameters": {
            "simulated_state": "operational",
            "message": "Multi-region session replication synchronized"
          }
        }
      ]
    },
    "billing-engine": {
      "product": "billing-engine",
      "pull_interval_seconds": 20,
      "checks": [
        {
          "id": "stripe-webhook-check",
          "feature": "stripe-connector",
          "type": "synthetic",
          "target": "https://api.stripe.com/healthcheck",
          "timeout_ms": 5000,
          "parameters": {
            "simulated_state": "operational",
            "message": "Webhooks processed with <50ms latency"
          }
        },
        {
          "id": "tax-jurisdiction-check-us",
          "feature": "tax-calc",
          "region": "us-east-1",
          "type": "synthetic",
          "target": "tax.us-east.cloud.internal:443",
          "timeout_ms": 5000,
          "parameters": {
            "simulated_state": "operational",
            "message": "US tax authority responding normally"
          }
        },
        {
          "id": "tax-jurisdiction-check-eu",
          "feature": "tax-calc",
          "region": "eu-west-1",
          "type": "synthetic",
          "target": "tax.eu-west.cloud.internal:443",
          "timeout_ms": 5000,
          "parameters": {
            "simulated_state": "degraded",
            "message": "Elevated response latency from upstream tax authority"
          }
        }
      ]
    }
  },
  "items": [
    { "tenant": "default", "template": "cloud-api" },
    { "tenant": "default", "template": "auth-service" },
    { "tenant": "default", "template": "billing-engine" },

    { "tenant": "acme", "template": "cloud-api" },
    {
      "tenant": "acme",
      "template": "billing-engine",
      "pull_interval_seconds": 30,
      "check_overrides": [
        { "id": "tax-jurisdiction-check-us", "target": "tax.us-east.acme.internal:443" },
        { "id": "tax-jurisdiction-check-eu", "remove": true }
      ]
    }
  ]
}'
